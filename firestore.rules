rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (request.auth.token.role == 'teacher' || request.auth.token.role == 'parent');
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isParent() {
      return signedIn() && request.auth.token.role == 'parent';
    }

    function isOwnStudent(studentId) {
      return isParent() && request.auth.token.studentId == studentId;
    }

    function isSemester(appId) {
      return appId.matches('^contact-book-[0-9]{3}-[0-9]{2}$');
    }

    function isOwnParentMessage() {
      return isOwnStudent(resource.data.studentId) && resource.data.sender == 'parent';
    }

    function keepsParentMessageIdentity() {
      return request.resource.data.studentId == resource.data.studentId
        && request.resource.data.sender == 'parent';
    }

    function onlyWithdrawsMessage() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['withdrawn', 'withdrawnAt', 'messageType', 'text']);
    }

    match /artifacts/{appId}/public/data/notes/{noteId} {
      allow read: if isSemester(appId) && signedIn();
      allow write: if isSemester(appId) && isTeacher();
    }

    match /artifacts/{appId}/public/data/calendar_events/{eventId} {
      allow read: if isSemester(appId) && signedIn();
      allow write: if isSemester(appId) && isTeacher();
    }

    match /artifacts/{appId}/public/data/holidays/{holidayId} {
      allow read: if isSemester(appId) && signedIn();
      allow write: if isSemester(appId) && isTeacher();
    }

    match /artifacts/{appId}/public/data/daily_records/{recordId} {
      allow get, list: if isSemester(appId) && (isTeacher() || isOwnStudent(resource.data.studentId));
      allow create: if isSemester(appId) && (
        isTeacher() ||
        (isOwnStudent(request.resource.data.studentId) && request.resource.data.date is string)
      );
      allow update: if isSemester(appId) && (
        isTeacher() ||
        (isOwnStudent(resource.data.studentId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.date == resource.data.date
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['signed', 'isLeave', 'signTime', 'leaveTime']))
      );
      allow delete: if isSemester(appId) && isTeacher();
    }

    // 線上請假單：僅該家長與教師可讀取手寫簽名與請假資料。
    match /artifacts/{appId}/public/data/leave_requests/{requestId} {
      allow get, list: if isSemester(appId) && (isTeacher() || isOwnStudent(resource.data.studentId));
      allow create: if isSemester(appId)
        && isOwnStudent(request.resource.data.studentId)
        && request.resource.data.date is string;
      allow update: if isSemester(appId) && (
        isTeacher() || (
          isOwnStudent(resource.data.studentId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.date == resource.data.date
        )
      );
      allow delete: if isSemester(appId) && isTeacher();
    }

    match /artifacts/contact-chat/public/data/group_chat/{messageId} {
      allow read: if signedIn();
      allow create: if isTeacher() || (
        isParent()
          && request.resource.data.sender == 'parent'
          && request.resource.data.studentId == request.auth.token.studentId
      );
      allow update: if isTeacher() || (
        isOwnParentMessage()
          && keepsParentMessageIdentity()
          && onlyWithdrawsMessage()
      );
      allow delete: if false;
    }

    match /artifacts/contact-chat/public/data/private_chats/{messageId} {
      allow get, list: if isTeacher() || isOwnStudent(resource.data.studentId);
      allow create: if isTeacher() || (
        isParent()
          && request.resource.data.sender == 'parent'
          && request.resource.data.studentId == request.auth.token.studentId
      );
      allow update: if isTeacher() || (
        isOwnParentMessage()
          && keepsParentMessageIdentity()
          && onlyWithdrawsMessage()
      );
      allow delete: if false;
    }

    match /artifacts/contact-chat/public/data/chat_read_states/teacher {
      allow read, write: if isTeacher();
    }

    match /artifacts/contact-chat/public/data/chat_read_states/{studentId} {
      allow get, create, update: if isOwnStudent(studentId)
        && request.resource.data.studentId == studentId;
      allow delete: if false;
    }

    // 教師建立表單；家長只能透過已知連結讀取開放中的單一表單，不能列出全部表單。
    match /artifacts/contact-forms/public/data/forms/{formId} {
      allow get: if isTeacher() || (isParent() && resource.data.status == 'open');
      allow list: if isTeacher();
      allow create, update, delete: if isTeacher();

      match /submissions/{studentId} {
        allow get: if isTeacher() || isOwnStudent(studentId);
        allow list: if isTeacher();
        allow create, update: if isParent()
          && isOwnStudent(studentId)
          && request.resource.data.studentId == studentId
          && get(/databases/$(database)/documents/artifacts/contact-forms/public/data/forms/$(formId)).data.status == 'open';
        allow delete: if isTeacher();
      }
    }
  }
}
